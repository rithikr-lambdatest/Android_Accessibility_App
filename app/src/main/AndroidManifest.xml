<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QA_Accessibility_App">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.QA_Accessibility_App">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- TE-20569: App & Screen Orientation Lock (WCAG 1.3.4) violation demo.
             android:screenOrientation="portrait" is the manifest attribute the
             FixedOrientationLock rule reads from the foreground activity. -->
        <activity
            android:name=".OrientationLockActivity"
            android:exported="false"
            android:label="Orientation Lock"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.QA_Accessibility_App" />
        <activity
            android:name=".LandscapeLockActivity"
            android:exported="false"
            android:label="Orientation Lock (Landscape)"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.QA_Accessibility_App" />
        <activity
            android:name=".NoSensorLockActivity"
            android:exported="false"
            android:label="Orientation Lock (No Sensor)"
            android:screenOrientation="nosensor"
            android:theme="@style/Theme.QA_Accessibility_App" />
        <!-- Pass case: fullSensor rotates with the device (not in the rule's FAIL set). -->
        <activity
            android:name=".RotatableActivity"
            android:exported="false"
            android:label="Rotatable (Pass)"
            android:screenOrientation="fullSensor"
            android:theme="@style/Theme.QA_Accessibility_App" />
    </application>

</manifest>