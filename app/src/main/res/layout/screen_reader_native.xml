            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#90A4AE"
            android:clickable="true"
            android:focusable="true"
            android:importantForAccessibility="yes" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F2F2F7"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="R1 P-03: Button WITH text (pass)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="id sr_r1_p03_native_button_labeled — same widget, now named. Negative control. Expect PASS."
            android:textSize="12sp"
            android:textColor="#555555"
            android:importantForAccessibility="no"
            android:layout_marginBottom="8dp" />

        <Button
            android:textAllCaps="false"
            android:id="@+id/sr_r1_p03_native_button_labeled"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Add to cart" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="R2 — Non-Interactive Focus Order (2.4.3, serious)"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#C62828"
        android:importantForAccessibility="no"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Non-interactive element reachable by TalkBack that announces nothing. The iOS equivalent never fired once across 19 screens, because StaticText and Image both carry a trait. Watch whether the Android role behaves the same."
        android:textSize="12sp"
        android:textColor="#555555"
        android:importantForAccessibility="no"
        android:layout_marginBottom="8dp" />

    <LinearLayout
