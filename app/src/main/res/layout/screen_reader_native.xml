            android:contentDescription="Chanel logo" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="R5 — Duplicate State Info (4.1.2, moderate)"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#C62828"
        android:importantForAccessibility="no"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="The label bakes in state TalkBack already announces (selected / checked / disabled; on / off only on toggles)."
        android:textSize="12sp"
        android:textColor="#555555"
        android:importantForAccessibility="no"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F2F2F7"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="R5 V-06: Switch labelled &quot;WiFi on&quot;"
            android:textSize="14sp"
            android:textStyle="bold"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="id sr_r5_v06_native_switch_on — &quot;on&quot; on a real switch. Expect FAIL."
            android:textSize="12sp"
            android:textColor="#555555"
            android:importantForAccessibility="no"
            android:layout_marginBottom="8dp" />

        <Switch
            android:id="@+id/sr_r5_v06_native_switch_on"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WiFi on"
            android:checked="true" />
