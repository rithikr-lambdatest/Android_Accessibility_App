    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="R7 — Visible Label Mismatch (2.5.3, serious)"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#C62828"
        android:importantForAccessibility="no"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Visible text and spoken output disagree. Android reads visible text from node.getText(), NOT OCR — so unlike iOS this should be exact, and any miss is a real logic bug."
        android:textSize="12sp"
        android:textColor="#555555"
        android:importantForAccessibility="no"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F2F2F7"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="R7 V-03: reads &quot;Buy Now&quot;, speaks otherwise"
            android:textSize="14sp"
            android:textStyle="bold"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="id sr_r7_v03_native_mismatch — visible text not contained in the spoken name. Expect FAIL."
            android:textSize="12sp"
            android:textColor="#555555"
            android:importantForAccessibility="no"
            android:layout_marginBottom="8dp" />

        <Button
            android:textAllCaps="false"
            android:id="@+id/sr_r7_v03_native_mismatch"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Buy Now"
            android:contentDescription="Complete purchase immediately" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F2F2F7"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="R7 P-03: reads &quot;Send&quot;, speaks &quot;Send message&quot; (pass)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="id sr_r7_p03_native_contains — visible text IS contained in the spoken name, must not fire. Expect PASS."
            android:textSize="12sp"
            android:textColor="#555555"
            android:importantForAccessibility="no"
            android:layout_marginBottom="8dp" />

        <Button
            android:textAllCaps="false"
            android:id="@+id/sr_r7_p03_native_contains"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Send"
            android:contentDescription="Send message" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#BDBDBD"
        android:importantForAccessibility="no"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Other screen-reader fixtures"
        android:textSize="16sp"
        android:textStyle="bold"
        android:importantForAccessibility="no"
        android:layout_marginBottom="8dp" />

    <!-- Native Buttons, not Compose, so this page stays 100% android.widget.* and its report is
         purely native. They ARE left in the accessibility tree so a manual TalkBack walk can reach
         the other fixtures; their names are deliberately clean and must not trigger any rule. -->
    <Button
        android:textAllCaps="false"
        android:id="@+id/sr_nav_linear_xml"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open Linear Navigation (XML)"
        android:layout_marginBottom="8dp" />

    <Button
        android:textAllCaps="false"
        android:id="@+id/sr_nav_phash_similar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open pHash Similar Screens"
        android:layout_marginBottom="8dp" />

    <Button
        android:textAllCaps="false"
        android:id="@+id/sr_nav_phash_animated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open pHash Animated Screen"
        android:layout_marginBottom="24dp" />

  </LinearLayout>
  </ScrollView>

  <!-- Native scroll arrows — same contentDescriptions as the Compose FABs so the test
       scripts' locators work unchanged, and each click is an auto-report trigger. -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="end|center_vertical"
    android:padding="8dp">

    <ImageButton
        android:id="@+id/sr_xml_arrow_up"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@android:drawable/arrow_up_float"
        android:contentDescription="Scroll up"
        android:layout_marginEnd="16dp" />

    <ImageButton
        android:id="@+id/sr_xml_arrow_down"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@android:drawable/arrow_down_float"
        android:contentDescription="Scroll down" />
  </LinearLayout>

</LinearLayout>
