            android:importantForAccessibility="yes" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F2F2F7"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="R2 P-02: TextView that announces normally (pass)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="id sr_r2_p02_native_textview_labeled — ordinary announced text. Expect PASS."
            android:textSize="12sp"
            android:textColor="#555555"
            android:importantForAccessibility="no"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/sr_r2_p02_native_textview_labeled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Section divider" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="R3 — Meaningless Spoken Output (1.1.1, serious)"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#C62828"
        android:importantForAccessibility="no"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="The accessible name is a generic word (button, view, image, icon, label, container)."
        android:textSize="12sp"
        android:textColor="#555555"
        android:importantForAccessibility="no"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F2F2F7"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="R3 V-03: label is the word &quot;View&quot;"
            android:textSize="14sp"
            android:textStyle="bold"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="id sr_r3_v03_native_generic_view — generic word as the whole name. Expect FAIL."
            android:textSize="12sp"
            android:textColor="#555555"
            android:importantForAccessibility="no"
            android:layout_marginBottom="8dp" />

        <Button
            android:textAllCaps="false"
            android:id="@+id/sr_r3_v03_native_generic_view"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="View" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F2F2F7"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="R3 V-04: contentDescription is &quot;icon&quot;"
            android:textSize="14sp"
            android:textStyle="bold"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="id sr_r3_v04_native_generic_icon — generic word. Expect FAIL."
            android:textSize="12sp"
            android:textColor="#555555"
            android:importantForAccessibility="no"
            android:layout_marginBottom="8dp" />

        <ImageView
            android:id="@+id/sr_r3_v04_native_generic_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_info_details"
            android:contentDescription="icon" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="R4 — Image Missing Spoken Output (1.1.1, serious)"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#C62828"
        android:importantForAccessibility="no"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Image elements with an empty or generic name (image, icon, picture, photo, img). Overlaps R2 by design — record WHICH rule claims each element."
        android:textSize="12sp"
        android:textColor="#555555"
        android:importantForAccessibility="no"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
