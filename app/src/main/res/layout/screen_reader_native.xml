<?xml version="1.0" encoding="utf-8"?>
<!--
  TE-24440 — Screen Reader rules, XML / android.widget.* page.

  Native twin of the Compose rules page, laid out the same way: a heading per rule, then one card
  per test element stating the case ID and the expected verdict. Every element here is a REAL
  android.widget.* view with a real android:id, so resource-id is always populated.

  All headings, captions and separators carry importantForAccessibility="no" and stay OUT of the
  accessibility tree. On the iOS run the equivalent captions were themselves reported as violations
  (a note reading: Label contains "Selected" fired the duplicate-state rule), which buried the real
  findings. Only the elements under test are announced, so every element in the report should map
  to a case ID in TE-24440-Android-ScreenReader-QA-TestPlan.md.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

  <ScrollView
    android:id="@+id/sr_xml_scroll_root"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Screen Reader — XML page"
        android:textSize="20sp"
        android:textStyle="bold"
        android:importantForAccessibility="no"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TE-24440. Every element is a real android.widget.* view. Same 7 rules as the Compose page — run both and diff the reports element for element."
        android:textSize="12sp"
        android:textColor="#555555"
        android:importantForAccessibility="no"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="R1 — Interactive Focus Order (2.4.3, critical)"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#C62828"
        android:importantForAccessibility="no"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Clickable elements with NO accessible name. One card per widget class, so the scan shows which classes R1 actually catches. If only EditText fires, the role is leaking into spokenOutput exactly as the trait does on iOS."
        android:textSize="12sp"
        android:textColor="#555555"
        android:importantForAccessibility="no"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F2F2F7"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="R1 V-03: Button, empty text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="id sr_r1_v03_native_button — real android.widget.Button, no name. Expect FAIL."
            android:textSize="12sp"
            android:textColor="#555555"
            android:importantForAccessibility="no"
            android:layout_marginBottom="8dp" />

        <Button
            android:textAllCaps="false"
            android:id="@+id/sr_r1_v03_native_button"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:text="" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F2F2F7"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="R1 V-04: ImageButton, no contentDescription"
            android:textSize="14sp"
            android:textStyle="bold"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="id sr_r1_v04_native_imagebutton — real android.widget.ImageButton. Expect FAIL."
            android:textSize="12sp"
            android:textColor="#555555"
            android:importantForAccessibility="no"
            android:layout_marginBottom="8dp" />

        <ImageButton
            android:id="@+id/sr_r1_v04_native_imagebutton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_search" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F2F2F7"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="R1 V-05: EditText, no hint or label"
            android:textSize="14sp"
            android:textStyle="bold"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="id sr_r1_v05_native_edittext — on iOS the text field was the ONLY class that could fire this rule. Expect FAIL."
            android:textSize="12sp"
            android:textColor="#555555"
            android:importantForAccessibility="no"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/sr_r1_v05_native_edittext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F2F2F7"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="R1 V-06: Switch, empty text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="id sr_r1_v06_native_switch — real android.widget.Switch. Expect FAIL."
            android:textSize="12sp"
            android:textColor="#555555"
            android:importantForAccessibility="no"
            android:layout_marginBottom="8dp" />

        <Switch
            android:id="@+id/sr_r1_v06_native_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F2F2F7"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="R1 V-07: clickable View, no label"
            android:textSize="14sp"
            android:textStyle="bold"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="id sr_r1_v07_native_clickable_view — plain android.view.View. RFC 10 known limitation: View sits in containerClasses and is only caught by the interactive-trait check. Expect FAIL."
            android:textSize="12sp"
            android:textColor="#555555"
            android:importantForAccessibility="no"
            android:layout_marginBottom="8dp" />

        <View
