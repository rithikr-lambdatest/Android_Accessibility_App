<?xml version="1.0" encoding="utf-8"?>
<!--
  TE-24440 — linear-navigation fixture, XML / android.widget.* variant.

  Native twin of the Compose linear-nav page. Content runs well past one viewport and includes a
  real android.widget.HorizontalScrollView carousel, so linear-navigation mode must scroll the
  page AND swipe the carousel to reach everything. Auto-report mode should only see what is on
  screen at the time of the trigger command.

  Scrolling here is a native ScrollView, which also exercises the native vertical-scroll path —
  the Compose page scrolls through Compose's own scrollable semantics instead.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

  <ScrollView
    android:id="@+id/sr_lin_xml_scroll_root"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Page chrome, kept out of the accessibility tree (see screen_reader_native.xml). -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Linear Navigation — XML page"
        android:textSize="20sp"
        android:textStyle="bold"
        android:importantForAccessibility="no"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Violations sit at the top, at the bottom, and inside the carousel. Only linear-navigation mode should find them all."
        android:textSize="12sp"
        android:importantForAccessibility="no"
        android:layout_marginBottom="12dp" />

    <!-- TOP violation — on screen from the start, so BOTH modes must find it. -->
    <EditText
        android:id="@+id/sr_lin_xml_top_r1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="text"
        android:layout_marginBottom="12dp" />

    <!-- Real HorizontalScrollView carousel — the exact class RFC 4.2 matches on. -->
    <include layout="@layout/screen_reader_carousel" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Scroll down for the off-screen violations"
        android:textSize="12sp"
        android:importantForAccessibility="no"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/sr_lin_xml_filler_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Filler row 1 — keep scrolling"
        android:background="#F5F5F5"
        android:padding="12dp"
        android:layout_marginBottom="8dp" />
    <TextView
        android:id="@+id/sr_lin_xml_filler_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Filler row 2 — keep scrolling"
        android:background="#F5F5F5"
        android:padding="12dp"
        android:layout_marginBottom="8dp" />
    <TextView
        android:id="@+id/sr_lin_xml_filler_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Filler row 3 — keep scrolling"
        android:background="#F5F5F5"
        android:padding="12dp"
        android:layout_marginBottom="8dp" />
    <TextView
        android:id="@+id/sr_lin_xml_filler_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Filler row 4 — keep scrolling"
        android:background="#F5F5F5"
        android:padding="12dp"
        android:layout_marginBottom="8dp" />
    <TextView
        android:id="@+id/sr_lin_xml_filler_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Filler row 5 — keep scrolling"
        android:background="#F5F5F5"
        android:padding="12dp"
        android:layout_marginBottom="8dp" />
    <TextView
        android:id="@+id/sr_lin_xml_filler_6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Filler row 6 — keep scrolling"
        android:background="#F5F5F5"
        android:padding="12dp"
        android:layout_marginBottom="8dp" />
    <TextView
        android:id="@+id/sr_lin_xml_filler_7"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Filler row 7 — keep scrolling"
        android:background="#F5F5F5"
        android:padding="12dp"
        android:layout_marginBottom="8dp" />
    <TextView
        android:id="@+id/sr_lin_xml_filler_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Filler row 8 — keep scrolling"
        android:background="#F5F5F5"
        android:padding="12dp"
        android:layout_marginBottom="8dp" />
    <TextView
        android:id="@+id/sr_lin_xml_filler_9"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Filler row 9 — keep scrolling"
        android:background="#F5F5F5"
        android:padding="12dp"
        android:layout_marginBottom="8dp" />
    <TextView
        android:id="@+id/sr_lin_xml_filler_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Filler row 10 — keep scrolling"
        android:background="#F5F5F5"
        android:padding="12dp"
        android:layout_marginBottom="8dp" />
    <TextView
        android:id="@+id/sr_lin_xml_filler_11"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Filler row 11 — keep scrolling"
        android:background="#F5F5F5"
        android:padding="12dp"
        android:layout_marginBottom="8dp" />
    <TextView
        android:id="@+id/sr_lin_xml_filler_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Filler row 12 — keep scrolling"
        android:background="#F5F5F5"
        android:padding="12dp"
        android:layout_marginBottom="8dp" />
    <TextView
        android:id="@+id/sr_lin_xml_filler_13"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Filler row 13 — keep scrolling"
        android:background="#F5F5F5"
        android:padding="12dp"
        android:layout_marginBottom="8dp" />
    <TextView
        android:id="@+id/sr_lin_xml_filler_14"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Filler row 14 — keep scrolling"
        android:background="#F5F5F5"
        android:padding="12dp"
        android:layout_marginBottom="8dp" />
    <TextView
        android:id="@+id/sr_lin_xml_filler_15"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Filler row 15 — keep scrolling"
        android:background="#F5F5F5"
        android:padding="12dp"
        android:layout_marginBottom="8dp" />
    <TextView
        android:id="@+id/sr_lin_xml_filler_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Filler row 16 — keep scrolling"
        android:background="#F5F5F5"
        android:padding="12dp"
        android:layout_marginBottom="8dp" />
    <TextView
        android:id="@+id/sr_lin_xml_filler_17"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Filler row 17 — keep scrolling"
        android:background="#F5F5F5"
        android:padding="12dp"
        android:layout_marginBottom="8dp" />
    <TextView
        android:id="@+id/sr_lin_xml_filler_18"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Filler row 18 — keep scrolling"
        android:background="#F5F5F5"
        android:padding="12dp"
        android:layout_marginBottom="8dp" />

    <!-- BOTTOM violations — only reachable after a full vertical scroll. -->

    <!-- R6: label repeats the element type. -->
    <Button
        android:textAllCaps="false"
        android:id="@+id/sr_lin_xml_bottom_r6"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Add to Cart Button"
        android:layout_marginBottom="8dp" />

    <!-- R7: visible text and spoken output disagree. -->
    <Button
        android:textAllCaps="false"
        android:id="@+id/sr_lin_xml_bottom_r7"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Buy Now"
        android:contentDescription="Complete purchase immediately"
        android:layout_marginBottom="8dp" />

    <!-- R4: image with no accessible name. -->
    <ImageView
        android:id="@+id/sr_lin_xml_bottom_r4"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/pepsi"
        android:importantForAccessibility="yes"
        android:layout_marginBottom="8dp" />

    <!-- R1: unlabelled interactive control at the very bottom. -->
    <ImageButton
        android:id="@+id/sr_lin_xml_bottom_r1"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_send"
        android:layout_marginBottom="24dp" />

  </LinearLayout>
  </ScrollView>

  <!-- Native scroll arrows — same contentDescriptions as the Compose FABs so the test
       scripts' locators work unchanged, and each click is an auto-report trigger. -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="end|center_vertical"
    android:padding="8dp">

    <ImageButton
        android:id="@+id/sr_xml_arrow_up"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@android:drawable/arrow_up_float"
        android:contentDescription="Scroll up"
        android:layout_marginEnd="16dp" />

    <ImageButton
        android:id="@+id/sr_xml_arrow_down"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@android:drawable/arrow_down_float"
        android:contentDescription="Scroll down" />
  </LinearLayout>

</LinearLayout>
