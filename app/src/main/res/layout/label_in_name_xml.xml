<?xml version="1.0" encoding="utf-8"?>
<!-- TE-21959 MismatchedLabelText (Label in Name, WCAG 2.5.3 A) — XML variants.
     Rule fires when an interactive element's contentDescription does NOT
     contain the visible text as a whole word (ACT-normalized). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="XML V-01: Unrelated cd (Delete / Save changes)"
        android:textStyle="bold"
        android:paddingBottom="4dp" />

    <Button
        android:id="@+id/xml_lin_v01"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Delete"
        android:contentDescription="Save changes" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="XML V-02: Opposite meaning (Send / Cancel)"
        android:textStyle="bold"
        android:paddingTop="12dp"
        android:paddingBottom="4dp" />

    <Button
        android:id="@+id/xml_lin_v02"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Send"
        android:contentDescription="Cancel" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="XML V-03: Partial word (Add / Address book)"
        android:textStyle="bold"
        android:paddingTop="12dp"
        android:paddingBottom="4dp" />

    <Button
        android:id="@+id/xml_lin_v03"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add"
        android:contentDescription="Address book" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="XML P-01: cd contains visible (Save / Save current draft)"
        android:textStyle="bold"
        android:paddingTop="12dp"
        android:paddingBottom="4dp" />

    <Button
        android:id="@+id/xml_lin_p01"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Save"
        android:contentDescription="Save current draft" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="XML P-02: No cd — rule not applicable (Print)"
        android:textStyle="bold"
        android:paddingTop="12dp"
        android:paddingBottom="4dp" />

    <Button
        android:id="@+id/xml_lin_p02"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Print" />
</LinearLayout>
