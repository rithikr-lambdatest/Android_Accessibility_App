<?xml version="1.0" encoding="utf-8"?>
<!--
  TE-24440 — native horizontal carousel for linear-navigation mode.

  RFC 4.2 detects carousels by class name (android.widget.HorizontalScrollView,
  androidx.viewpager.widget.ViewPager, ViewPager2) AND geometry:
      width >= 80% viewport  AND  height > 0  AND  height < 85% viewport.
  This is a real HorizontalScrollView sized to satisfy that filter, so it must be picked up as a
  scrollContainer and swiped.

  15 product cards, EVERY ONE A DIFFERENT DRAWABLE. Unique images matter for two reasons: the
  bounding-box overlay in the report can be checked against the right artwork, and a screenshot of
  a mid-carousel scroll position is unambiguous about how far the swipe actually got. Repeated
  artwork would also feed near-identical frames to the pHash comparison and could mask a
  scroll-exhaustion misfire.
-->
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sr_lin_xml_carousel"
    android:layout_width="match_parent"
    android:layout_height="140dp"
    android:scrollbars="horizontal">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageView
            android:id="@+id/sr_lin_xml_card_1"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:src="@drawable/nike"
            android:contentDescription="Nike running shoe"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/sr_lin_xml_card_2"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:src="@drawable/pepsi"
            android:contentDescription="Pepsi can"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/sr_lin_xml_card_3"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:src="@drawable/chanel"
            android:contentDescription="Chanel perfume"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/sr_lin_xml_card_4"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:src="@drawable/gshock_watch"
            android:contentDescription="G-Shock wrist watch"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/sr_lin_xml_card_5"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:src="@drawable/smartwatch_face"
            android:contentDescription="Smartwatch with fitness face"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/sr_lin_xml_card_6"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:src="@drawable/paddle_brush"
            android:contentDescription="Paddle hair brush"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/sr_lin_xml_card_7"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:src="@drawable/surface_cleaner_can"
            android:contentDescription="Surface cleaner spray can"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/sr_lin_xml_card_8"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:src="@drawable/garbage_bags_pack"
            android:contentDescription="Pack of garbage bags"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/sr_lin_xml_card_9"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:src="@drawable/wooden_dice"
            android:contentDescription="Wooden dice set"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/sr_lin_xml_card_10"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:src="@drawable/camera"
            android:contentDescription="Instant film camera"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/sr_lin_xml_card_11"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:src="@drawable/mona_lisa_art"
            android:contentDescription="Mona Lisa art print"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/sr_lin_xml_card_12"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:src="@drawable/wall_art"
            android:contentDescription="Framed wall art"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/sr_lin_xml_card_13"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:src="@drawable/greeting_card"
            android:contentDescription="Greeting card"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/sr_lin_xml_card_14"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:src="@drawable/love_sticker"
            android:contentDescription="Love heart sticker"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/sr_lin_xml_card_15"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:src="@drawable/quote_card"
            android:contentDescription="Motivational quote card"
            android:layout_marginEnd="8dp" />

        <!-- ================= OFF-SCREEN VIOLATIONS =================
             These sit at the far end of the carousel on purpose. Card 1 is visible at rest, so
             reaching these needs several horizontal swipes — if the earlier ones are reported and
             the later ones are not, the horizontal pass stopped short rather than exhausting the
             carousel. Every drawable above is distinct, so a violation can never be mistaken for a
             repeat of an earlier card in a screenshot. -->

        <!-- R4: image whose name is the generic word "image". -->
        <ImageView
            android:id="@+id/sr_lin_xml_carousel_r4"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:src="@drawable/typography_poster"
            android:contentDescription="image"
            android:layout_marginEnd="8dp" />

        <!-- R2/R4: image with NO contentDescription at all, forced into the tree. -->
        <ImageView
            android:id="@+id/sr_lin_xml_carousel_r4b"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:src="@drawable/book_ikigai"
            android:importantForAccessibility="yes"
            android:layout_marginEnd="8dp" />

        <!-- R6: label repeats the element type. -->
        <Button
            android:textAllCaps="false"
            android:id="@+id/sr_lin_xml_carousel_r6"
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:text="Checkout Button"
            android:layout_marginEnd="8dp" />

        <!-- R1: unlabelled interactive control, the very last item in the carousel. Its presence
             in the report is the strongest evidence the carousel was swiped all the way. -->
        <ImageButton
            android:id="@+id/sr_lin_xml_carousel_r1"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_add" />

    </LinearLayout>
</HorizontalScrollView>
